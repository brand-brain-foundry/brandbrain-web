{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documento del sitio — brandbrain-web (content/site.json)",
  "description": "La identidad editable (nombre, cargo, buzón, forma jurídica, destinos de los enlaces; D-BBW-78) y el bloque de entidad (S2, P-BBW-95). Generado desde src/content/{site,entity-fields,site-schema}.ts por `pnpm content:schema`; no se edita a mano.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brand",
    "role",
    "email",
    "legalForm",
    "links",
    "entity"
  ],
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*<\\/?[a-zA-Z!])",
      "description": "El nombre: una sola cadena, completa y sin variantes (D-BBW-58).",
      "x-cms": "short-text"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*<\\/?[a-zA-Z!])",
      "description": "El cargo (D-BBW-61).",
      "x-cms": "short-text",
      "x-translatable": true
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "description": "El buzón publicado, sin «mailto:» (lo pone el código).",
      "x-cms": "email"
    },
    "legalForm": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*<\\/?[a-zA-Z!])",
      "description": "La forma jurídica, para los textos legales por {{legalForm}} (P-BBW-80).",
      "x-cms": "short-text",
      "x-translatable": true
    },
    "links": {
      "type": "object",
      "description": "A dónde apunta la web fuera de sí misma, por ROL. Destinos absolutos y cifrados. «contact» es reservada: el código la deriva de $.email.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$",
        "not": {
          "const": "contact"
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^https://[^\\s]+$"
      },
      "x-cms": "repeater"
    },
    "fieldMedia": {
      "type": "object",
      "description": "OPCIONAL (S12, modelo v3.15). Puntos focales de los medios de los lotes del campo: { uso: { nombre del medio: { x, y } } }, fracciones del ancho y del alto del maestro. El guion de medios recorta cada medio al cuadrado mayor centrado en ese punto; sin entrada, el centro. Uso y nombre = la carpeta media/masters/campo/<uso>/ y el archivo sin extensión.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "x-cms": "media-focus"
    },
    "entity": {
      "type": "object",
      "description": "Lo que hace citable a la persona. Cada campo con su estado; un campo entra en los datos estructurados solo si está aprobado y es visible en la página. ProfilePage se activa cuando están aprobados: name, image, sameAs.",
      "additionalProperties": false,
      "required": [
        "name",
        "alternateName",
        "role",
        "email",
        "category",
        "motto",
        "description",
        "descriptionLong",
        "knowsAbout",
        "credentials",
        "image",
        "location",
        "sameAs",
        "relations"
      ],
      "properties": {
