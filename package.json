{
  "name": "brandbrain-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm lint:seo && pnpm lint:backdrop --served",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:color": "tsx scripts/lint/check-color-tokens.ts",
    "lint:color:baseline": "tsx scripts/lint/check-color-tokens.ts --write-baseline",
    "lint:typo": "tsx scripts/lint/check-typography-tokens.ts",
    "lint:typo:baseline": "tsx scripts/lint/check-typography-tokens.ts --write-baseline",
    "lint:type-system": "tsx scripts/lint/check-typography-system.ts",
    "lint:content": "tsx scripts/lint/check-content.ts",
    "lint:media": "tsx scripts/lint/check-media.ts",
    "lint:budget": "tsx scripts/lint/check-context-budget.ts",
    "lint:legal": "tsx scripts/lint/check-legal-data.ts",
    "lint:rig": "tsx scripts/lint/check-brand-mark-rig.ts",
    "lint:scatter": "tsx scripts/lint/check-glyph-scatter.ts",
    "lint:seo": "tsx scripts/lint/check-seo.ts",
    "lint:backdrop": "tsx scripts/lint/check-backdrop.ts",
    "content:schema": "tsx scripts/content/export-schema.ts",
    "media:build": "tsx scripts/media/build.ts",
    "preview": "pnpm build && tsx scripts/preview/serve.ts",
    "preview:serve": "tsx scripts/preview/serve.ts",
    "guard": "pnpm lint:color && pnpm lint:typo && pnpm lint:type-system && pnpm lint:content && pnpm lint:legal && pnpm lint:media && pnpm lint:budget && pnpm lint:rig && pnpm lint:scatter && pnpm lint:backdrop",
    "check": "pnpm typecheck && pnpm lint && pnpm guard"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "0.35.4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1",
  "description": "Sitio de la práctica profesional de Christian Zavala Cubas — landing estática ES/EN (Next.js output: export). Contrato de hosting: docs/system/DEPLOY_CONTRACT.md",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  }
}
